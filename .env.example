# Optional; when unset the website runs with demo listings and manual CSV import.
# New Google Routes API (Compute Routes TRANSIT, Pro SKU). No Geocoding API needed.
# Roost will NOT make requests after either budget is reached.
# Fixed code ceilings: max 4,000 routes/month and 100 routes/day, no overrides upward.
# Keep at zero to completely disable all Google routing calls.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_MONTHLY_LIMIT=4000
GOOGLE_ROUTES_DAILY_LIMIT=100
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nyc-apartment-scout/0.1 by your-reddit-username
# Reddit API use requires Reddit approval; credentials alone may not grant access.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
SMTP_TLS=true
# Protect any internet-facing deployment with a reverse proxy + authentication.
ADMIN_TOKEN=
POLL_MINUTES=15
# Optional authorized feed URL returning a JSON array of listings
LICENSED_LISTING_FEED_URL=
LICENSED_LISTING_FEED_BEARER=

# FREE StreetEasy API access from https://api.sh/streeteasy-api
# 1,000 monthly free credits advertised as of 2026-11; cap locally at 900.
# No paid fallback, no automatic purchase. Each listed borough costs 1 credit/check.
APISH_KEY=
APISH_AREAS=manhattan,brooklyn,queens
APISH_INTERVAL_MINUTES=180
APISH_MONTHLY_BUDGET=900

# Optional free fallback: ingest YOUR OWN StreetEasy saved-search alert emails.
# Set StreetEasy notifications to instant; IMAP requires app-specific password where applicable.
# The inbox is read-only; no automated login to StreetEasy.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
